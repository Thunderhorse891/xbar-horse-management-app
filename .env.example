# XBAR environment configuration
#
# Copy to `.env.local` (git-ignored) and fill in what you need.
#
# HOW TO READ THIS FILE
# ---------------------
# Every variable is marked with:
#
#   [client]  Prefixed VITE_ and compiled into the browser bundle. Anyone can
#             read these by viewing source. Never put a secret behind a VITE_
#             prefix — a publishable/anon key is fine, a service-role or secret
#             key is not.
#   [server]  Read only by the API functions in api/. Never sent to the browser.
#
#   OPTIONAL NOW   the app runs without it; the section says exactly what
#                  happens when it is absent.
#   REQUIRED LATER needed before that capability works in production.
#
# NOTHING HERE IS REQUIRED TO RUN THE APP LOCALLY. With this file empty, XBAR
# starts in local mode: records live in the browser, cloud sync is off, no
# plans can be purchased, and every screen says so rather than pretending
# otherwise. Missing configuration never fakes success.


# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE — cloud accounts, sync, storage
# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL NOW / REQUIRED LATER for any cloud workspace.
#
# WHEN ABSENT: the app runs entirely locally. Sign-in is hidden, workspaces are
# stored in the browser, and server features (document OCR upload, sale packet
# PDFs, invitations) are unavailable rather than failing mid-action.
#
# TO ACTIVATE:
#   1. Create a project at supabase.com.
#   2. Settings > API: copy the Project URL and the publishable (anon) key into
#      the two [client] values below.
#   3. Settings > API: copy the service_role key into SUPABASE_SERVICE_ROLE_KEY
#      below. It bypasses row-level security — server-side only, never VITE_.
#   4. Apply the schema: supabase/production-schema.sql, then the migrations in
#      supabase/migrations/ in filename order UP TO AND INCLUDING
#      20260724_storage_limit_enforcement.sql.
#   5. STOP before the three 20260820-20260822 migrations. Each is deliberately
#      unapplied and carries its own procedure in its header, and one of them
#      changes customer entitlement data. Read them, in this order, before
#      running anything:
#        20260820_entitlement_helpers_honor_inactive.sql  (schema only)
#        20260821_reconcile_legacy_manual_billing.sql     (CHANGES DATA — run
#            its dry-run first and read the per-row disposition it prints)
#        20260822_restrict_anon_rpc_surface.sql           (grants; staging first)
#      `node scripts/verify-rpc-surface.mjs "$DATABASE_URL"` reports what each
#      role can execute before and after the last one.
#      README.md > "Pending migrations" has the full procedure.
VITE_SUPABASE_URL=                    # [client] project URL
VITE_SUPABASE_ANON_KEY=               # [client] publishable/anon key — public by design

# [client] Which third-party sign-in buttons the login screen may draw, as a
# comma-separated list of google, facebook, apple. UNSET MEANS NONE, which is
# the safe default: Supabase answers a redirect for any provider that is not
# enabled in its own auth settings with HTTP 400 "Unsupported provider:
# provider is not enabled", and the customer just sees a button that does
# nothing. Only list a provider here once it is enabled in the Supabase
# dashboard (Authentication > Providers) AND its OAuth client is registered
# with the provider itself — listing it early is how the dead buttons come
# back. Native store builds show none of them regardless of this setting,
# because a web OAuth redirect cannot complete inside the app WebView.
VITE_AUTH_OAUTH_PROVIDERS=

# [client] Storage and sync shape. Defaults shown are what the app uses when
# these are unset; change them only to match a differently-named project.
VITE_SUPABASE_WORKSPACE_TABLE=workspace_snapshots
# VITE_SUPABASE_RELATIONAL_MIRROR is the former name for this setting and is
# still read as a fallback. Prefer VITE_SUPABASE_RELATIONAL_SYNC; setting both
# means the _SYNC value wins.
VITE_SUPABASE_RELATIONAL_SYNC=true
VITE_SUPABASE_SNAPSHOT_FALLBACK=true
VITE_SUPABASE_MEDIA_BUCKET=horse-media
VITE_SUPABASE_DOCUMENT_BUCKET=horse-documents

# [client] OPTIONAL NOW. Allows using the app with no cloud account at all.
# Defaults to on in development and off in a production build.
#
# Set to `true` here to match that development default, because this file is
# meant to be copied to .env.local. It previously read `false`, which
# contradicted the line above and silently opted a developer OUT of the default
# the comment promised them.
#
# It is not a lockout either way — with Supabase blank, RequireCloudAuth routes
# to /login on both settings, and Login offers "Create workspace" whenever
# Supabase is unconfigured. Verified in a browser: land on Sign In, click
# Create workspace, arrive at Configure Workspace. But a template should still
# hand you the default it documents.
VITE_ALLOW_LOCAL_MODE=true

# [server] REQUIRED LATER, alongside the client values above.
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security. Treat it like a
# password: server environment only, never in this file once filled in, never
# VITE_ prefixed.
#
# WHEN ABSENT: every api/ route that needs the database returns a clear error
# instead of attempting the work.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# STRIPE — subscription billing
# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL NOW / REQUIRED LATER to sell plans.
#
# WHEN ABSENT: every tier, price, limit and feature list is still shown in full
# so plans can be compared, and the billing screen says exactly this:
#
#     Billing not configured yet
#
# No checkout opens, no subscription record is created, no identifier is
# invented, and the workspace's plan does not change. There is no in-app path
# to a paid plan until these are set.
#
# TO ACTIVATE:
#   1. Create the four recurring prices in the Stripe dashboard and paste their
#      price IDs below. An unrecognized price ID is rejected by the webhook
#      rather than guessed at, so these must match exactly.
#   2. Add a webhook endpoint pointing at /api/stripe/webhook, subscribed to
#      checkout.session.completed, customer.subscription.updated and
#      customer.subscription.deleted. Paste its signing secret.
#   3. Set MANAGED_BILLING_ENABLED=true and VITE_MANAGED_BILLING_ENABLED=true.
#      Both are needed: the server one authorizes checkout, the client one
#      decides whether to offer it.
#
# Which statuses grant access is decided in one place,
# api/_lib/subscription-status.js: active and trialing are entitled, past_due
# drops to the baseline plan, and everything else — canceled, paused, unpaid,
# incomplete, anything unrecognized — is not entitled.
STRIPE_SECRET_KEY=                    # [server]
STRIPE_WEBHOOK_SECRET=                # [server]
STRIPE_PRICE_ID_STARTER=              # [server]
STRIPE_PRICE_ID_PROFESSIONAL=         # [server]
STRIPE_PRICE_ID_RANCH_OPS=            # [server]
STRIPE_PRICE_ID_ENTERPRISE=           # [server]
MANAGED_BILLING_ENABLED=false         # [server] server-side checkout switch
VITE_MANAGED_BILLING_ENABLED=false    # [client] offer checkout in the UI

# [client] OPTIONAL. Hosted payment links, used as a fallback when a managed
# checkout session cannot be created. Setting these makes plans purchasable
# even with MANAGED_BILLING_ENABLED=false.
VITE_STRIPE_PAYMENT_LINK_STARTER=
VITE_STRIPE_PAYMENT_LINK_PROFESSIONAL=
VITE_STRIPE_PAYMENT_LINK_RANCH_OPS=
VITE_STRIPE_PAYMENT_LINK_ENTERPRISE=

# [client] OPTIONAL. A Stripe billing portal link. This is where a workspace
# that ALREADY has a subscription is sent to upgrade, downgrade, settle a
# failed payment, or cancel — the app refuses to open a second checkout for
# them, because that would bill them twice alongside the first. Leave it empty
# and those workspaces are told, honestly, that the change has to happen in
# Stripe; set it and they get a working button instead of a dead end.
VITE_STRIPE_BILLING_PORTAL_URL=


# ─────────────────────────────────────────────────────────────────────────────
# OWNER ACCESS — previewing tiers without buying them
# ─────────────────────────────────────────────────────────────────────────────
# Both are OPTIONAL and both are OFF by default. Neither changes anything for a
# real customer when unset.
#
# Preview is a read-time overlay: it never writes to the workspace's real
# subscription, so returning to the real plan is switching the overlay off
# rather than repairing data.
#
# It changes what you can SEE, never what you can CREATE. Screens and features
# unlock at the previewed tier; the gates that decide whether a record may be
# created — horses, document intakes, sale packets, invitations, listings —
# still evaluate the real plan, and refuse with a message that says you are
# previewing. Capacity is a server-side entitlement, and a client overlay is not
# one.

# Comp allowlist — comma/space separated emails.
#
# Set BOTH, to the same list. The server one is what actually grants cloud
# entitlements; the client one lets the UI show the same thing. Setting only
# the client value shows tiers the server will refuse to honour.
XBAR_COMP_EMAILS=                     # [server] the real grant
VITE_XBAR_COMP_EMAILS=                # [client] matching UI view

# Local owner preview — development only.
#
# Lets the owner exercise tier-gated screens on a machine with no cloud account.
#
# ⚠ THIS IS DELIBERATELY UNAVAILABLE IN PRODUCTION. It is a build-time value, so
#   it cannot be switched on from a URL, from localStorage, or from anything
#   else a visitor can edit at runtime — and a production bundle refuses it even
#   when the variable is set in the deploy environment. Do not expect it to work
#   on a deployed site; use the comp allowlist above for that.
#
# It grants a preview of the UI only. Record-creating gates evaluate the real
# plan regardless of the previewed tier, so a preview of Enterprise cannot
# create Enterprise-limit data.
#
# Not left to the API to refuse: with relational sync off, the workspace syncs
# through a direct workspace_snapshots upsert whose RLS checks row ownership and
# nothing about entitlements, so there is no API in that path to refuse
# anything. The refusal has to happen at the gate.
VITE_XBAR_LOCAL_OWNER_MODE=false      # [client] dev builds only


# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION URLS
# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL NOW / REQUIRED LATER for anything that emails a link (invitations,
# password reset) or links out of the app.
#
# WHEN ABSENT: links fall back to the deployment origin where one can be
# detected, and to relative paths otherwise.
#
# BOTH ARE ORIGINS. Neither may carry a path.
#
# `npm run build` moves the SPA shell to app.html, served under /app/*, and
# replaces / with static marketing HTML. It is tempting to encode that by
# setting VITE_PUBLIC_APP_URL to https://your-domain/app. Do not: the server
# reads the same variable and appends the path itself, so api/sale-packets.js
# would build /app/app/verify/<id> and break the verification link printed in
# every sale packet.
#
# VITE_PUBLIC_SITE_URL exists because in-app links to /privacy and /terms are
# marketing pages, and inside a store build a bare path is a dead link. It
# defaults to the app origin when unset.
VITE_PUBLIC_APP_URL=                  # [client+server] origin only, no path
VITE_PUBLIC_SITE_URL=                 # [client] marketing origin, no path
PUBLIC_APP_URL=                       # [server] used when building emailed links
VITE_API_BASE_URL=                    # [client] empty means same-origin /api


# ─────────────────────────────────────────────────────────────────────────────
# OCR + DOCUMENT PIPELINE  [server]
# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL. WHEN ABSENT: documents are read in the browser (tesseract.js /
# pdf.js) and the extracted text is sent with the upload. Setting
# OCR_PROVIDER=textract moves that work to AWS Textract instead.
OCR_PROVIDER=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SUPABASE_DOCUMENT_BUCKET=horse-documents
SUPABASE_SALE_PACKET_BUCKET=sale-packets


# ─────────────────────────────────────────────────────────────────────────────
# REMINDERS + OUTBOUND EMAIL  [server]
# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL. Configure either Resend or SendGrid. WHEN ABSENT: reminders appear
# in the app only and nothing is emailed. CRON_SECRET authenticates the
# scheduled reminder endpoint; without it that endpoint refuses to run.
CRON_SECRET=
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=


# ─────────────────────────────────────────────────────────────────────────────
# RATE LIMITING  [server]
# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL. With Upstash Redis credentials, per-IP limits are shared across
# every serverless instance. WHEN ABSENT: the limiter still works but counts
# per instance, so effective limits are looser under load.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# MISCELLANEOUS  [client]
# ─────────────────────────────────────────────────────────────────────────────
# Facebook sharing: WHEN ABSENT, the share action reports that sharing is not
# configured instead of opening a broken dialog.
VITE_FACEBOOK_APP_ID=

# Runtime monitoring. Sending telemetry to the API defaults to on only when
# VITE_API_BASE_URL is set, so it stays off in a local-only setup.
VITE_RUNTIME_MONITORING_ENABLED=true
VITE_RUNTIME_TELEMETRY_API_ENABLED=false

# Lets buyer share links be previewed locally without publishing them.
# Defaults to on in development and off in a production build.
VITE_PUBLIC_SHARE_LOCAL_PREVIEW=false
